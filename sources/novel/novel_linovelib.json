    "ruleSearch": {
        "bookList": "li.book-li",
        "bookName": "a.book-title@text",
        "bookUrl": "a.book-title@href",
        "bookCoverUrl": "a.book-cover img@src||.book-cover img@src",
        "bookAuthor": ".book-author@text"
    },
    "ruleExplore": {
        "bookList": "li.book-li",
        "bookName": "a.book-title@text",
        "bookUrl": "a.book-title@href",
        "bookCoverUrl": "a.book-cover img@src||.book-cover img@src",
        "bookAuthor": ".book-author@text"
    },
    "ruleBookInfo": {
        "name": "h1.book-name@text",
        "author": "meta[property=og:novel:author]@content",
        "coverUrl": ".book-img.fl img@src||meta[property=og:image]@content",
        "intro": ".book-dec.Jbook-dec p@text",
        "kind": "meta[property=og:novel:category]@content",
        "tocUrl": "meta[property=og:novel:read_url]@content"
    },
    "ruleToc": {
        "chapterList": ".chapter-list.clearfix li.col-4 a",
        "chapterName": "@text",
        "chapterUrl": "@href"
